    "test:staff-kiosk-scope": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test lib/staffKioskScope.test.ts",
    "test:staff-pin-email": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test lib/staffPinEmail.test.ts",
    "test:staff-payroll-probation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test lib/staffPayrollProbation.test.ts",
    "test:staff-payroll-policy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test lib/hrPayrollPolicy.test.ts",
    "test:staff-payroll-period": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test lib/staffPayrollPeriod.test.ts",
